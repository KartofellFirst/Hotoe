def _download(url, dest_path):
    logger.info("Downloading %s -> %s", url, dest_path)
    dest_dir = os.path.dirname(dest_path) or "."
    os.makedirs(dest_dir, exist_ok=True)
    tmp_path = dest_path + ".part"
    req = Request(url, headers={"User-Agent": "hotoe-cli"})
    try:
        with urlopen(req, timeout=60) as resp, open(tmp_path, "wb") as out:
            shutil.copyfileobj(resp, out)
        os.replace(tmp_path, dest_path)  
    except Exception:
        if os.path.exists(tmp_path):
            os.remove(tmp_path)
        raise

def download_fxapi():
    dest_path = os.path.join(CACHE_DIR, PLATFORM, "fxAPI.js")
    if os.path.exists(dest_path): return dest_path 
    _download(FXAPI_JS_URL[PLATFORM], dest_path)
    return dest_path

def _engine_is_ready(eng_dir):
    return os.path.isfile(os.path.join(eng_dir, ENGINE_READY_MARKER))

def download_engine(force=False):
    eng_dir = os.path.join(CACHE_DIR, PLATFORM)
    if force and os.path.isdir(eng_dir):
        shutil.rmtree(eng_dir)
    if _engine_is_ready(eng_dir):
        return eng_dir

    os.makedirs(eng_dir, exist_ok=True)
    zip_path = os.path.join(eng_dir, "_engine_download.zip")
    _download(ENGINE_ZIP_URL[PLATFORM], zip_path)

    with zipfile.ZipFile(zip_path, "r") as zf:
        zf.extractall(eng_dir)
    os.remove(zip_path)

    with open(os.path.join(eng_dir, ENGINE_READY_MARKER), "w") as f:
        f.write("ok")

    download_fxapi()
    return eng_dir

