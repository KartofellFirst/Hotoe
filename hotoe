    "focus": "window.addEventListener('focusEvent', function(event) { const focus = event.detail;",
}

logger = logging.getLogger("hotoe")


# ============================================================
# Platform detection
# ============================================================

def detect_platform():
    """Returns 'linux-wayland', 'linux-x11', 'windows', 'macos', or 'unknown'."""
    system = platform.system()

    if system == "Linux":
        if os.environ.get("XDG_SESSION_TYPE", "").lower() == "wayland" or os.environ.get(
            "WAYLAND_DISPLAY"
        ):
            return "linux-wayland"
        return "linux-x11"

    if system == "Windows":
        return "windows"

    if system == "Darwin":
        return "macos"

    return "unknown"


# ============================================================
# Downloading (stdlib only — no `requests` dependency)
# ============================================================

def _download(url, dest_path):
    logger.info("Downloading %s -> %s", url, dest_path)
    os.makedirs(os.path.dirname(dest_path) or ".", exist_ok=True)
    req = Request(url, headers={"User-Agent": "hotoe-cli"})
    with urlopen(req, timeout=60) as resp, open(dest_path, "wb") as out:
        shutil.copyfileobj(resp, out)


def download_fxapi(dest_path=None):
    """Downloads fxAPI.js on its own (used by both `run` and `compile`)."""
    if dest_path is None:
        dest_path = os.path.join(ENGINE_DIR, "fxAPI.js")
    _download(FXAPI_JS_URL, dest_path)
    return dest_path


def download_engine(force=False):
    """
    Downloads engine.zip, extracts it into ENGINE_DIR, and downloads
    fxAPI.js into ENGINE_DIR/fxAPI.js. Used by `run` only.
    """
    if force and os.path.isdir(ENGINE_DIR):
        shutil.rmtree(ENGINE_DIR)

    os.makedirs(ENGINE_DIR, exist_ok=True)

    zip_path = os.path.join(ENGINE_DIR, "_engine_download.zip")
    _download(ENGINE_ZIP_URL, zip_path)

    with zipfile.ZipFile(zip_path, "r") as zf:
        zf.extractall(ENGINE_DIR)
    os.remove(zip_path)

    download_fxapi(os.path.join(ENGINE_DIR, "fxAPI.js"))

    return ENGINE_DIR


# ============================================================
# Wayland dependency checks
# ============================================================
# Based on:
#   from ctypes import CDLL
#   try: CDLL('libgtk4-layer-shell.so')
#   except: print("WTF?")
#   import gi
#   gi.require_version('Gtk', '4.0')
#   gi.require_version('Gtk4LayerShell', '1.0')
#   gi.require_version('WebKit', '6.0')
#   from gi.repository import Gtk, Gio, Gdk, Gtk4LayerShell, WebKit
#   import cairo
#   import zmq
#
# stdlib-only imports (sys/os/json/threading/...) are skipped — never the
# actual point of failure.

def _check_ctypes_lib(lib_name):
    from ctypes import CDLL

    try:
        CDLL(lib_name)
        return True, None
    except Exception as e:  # noqa: BLE001
        return False, str(e)


def _check_import(module_name):
    try:
        importlib.import_module(module_name)
        return True, None
    except Exception as e:  # noqa: BLE001
        return False, str(e)


def _check_gi_stack():
    try:
        import gi

        gi.require_version("Gtk", "4.0")
        gi.require_version("Gtk4LayerShell", "1.0")
        gi.require_version("WebKit", "6.0")
        from gi.repository import Gtk, Gio, Gdk, Gtk4LayerShell, WebKit  # noqa: F401

        return True, None
    except Exception as e:  # noqa: BLE001
        return False, str(e)


def check_wayland_dependencies():
    """Checks every dependency individually, logs [OK]/[FAIL] for each, returns True iff all pass."""
    checks = [
        ("libgtk4-layer-shell.so", lambda: _check_ctypes_lib("libgtk4-layer-shell.so")),
        ("gi (PyGObject)", lambda: _check_import("gi")),
        ("gi.repository: Gtk4 / Gtk4LayerShell / WebKit6", _check_gi_stack),
        ("cairo (pycairo)", lambda: _check_import("cairo")),
        ("zmq (pyzmq)", lambda: _check_import("zmq")),
    ]

    all_ok = True
    for label, check_fn in checks:
        ok, error = check_fn()
        if ok:
            logger.info("[OK]   %s", label)
        else:
            all_ok = False
            logger.error("[FAIL] %s -> %s", label, error)

    return all_ok


# ============================================================
# Parser (adapted from the original parse_app.py)
# ============================================================

class AppParser:
    def __init__(self, source_dir, fxapi_path, output_path):
        self.source_dir = source_dir
        self.input_file = os.path.join(source_dir, "index.html")
        self.fxapi_path = fxapi_path
        self.output_path = output_path
        self.content = ""
        self.fxAPI = ""

    def parse(self):
        with open(self.input_file, "r", encoding="utf-8") as f:
            self.content = f.read()
        with open(self.fxapi_path, "r", encoding="utf-8") as f:
            self.fxAPI = f.read()

        self._inline_external_assets()

        if "<script>" not in self.content:
            self.content = self.content.replace("</body>", "<script></script></body>")
        if "<head>" not in self.content:
            self.content = self.content.replace("<body>", "<head></head><body>")

        self.content = re.sub(r"<html[^>]*>", "<html>", self.content, flags=re.IGNORECASE)
        self.content = self.content.replace(
            "</head>", "<style>html { background: rgba(0,0,0,0.01); }</style>"
        )

        self.content = self.content.replace(
            "<script>", f"\n<script>\n{self.fxAPI}\n</script>\n<script>"
        )

        self.content = self.content.replace("{% LOCAL_BUS_ADDRESS %}", "ipc://hotoe-bus.ipc")

        # IRR -> input region regulator. SIR -> set input region
        self.content = re.sub(
            rf"<\s*(\w+)([^>]*?)\s+{re.escape('SIR')}([^>]*)>",
            r'<\1\2 class="hotoe-input-region-regulator-box"\3>',
            self.content,
        )

        for key, val in SHORTCUTS.items():
            self._smart_method_replace(key, val)

        for key, val in LISTENERS.items():
            self._smart_listener_replace(key, val)

        os.makedirs(os.path.dirname(self.output_path) or ".", exist_ok=True)
        with open(self.output_path, "w", encoding="utf-8") as f:
            f.write(self.content)

        logger.info("Parsed app written to %s", self.output_path)
        return self.output_path

    def _smart_method_replace(self, replace, replaced):
        pattern = rf"(?<!\.)\b{re.escape(replace)}\s*\("
        self.content = re.sub(pattern, f"{replaced}(", self.content)

    def _smart_listener_replace(self, key, js_prefix):
        pattern = re.compile(rf"(?<![:\w])\b{re.escape(key)}\s*\{{")
        result = []
        pos = 0
        content = self.content

        while True:
            m = pattern.search(content, pos)
            if not m:
                result.append(content[pos:])
                break
            result.append(content[pos:m.start()])

            depth = 1
            i = m.end()
            state = None  # None | 'sq' | 'dq' | 'tpl' | 'line_comment' | 'block_comment'
            tpl_depth = 0

            while i < len(content) and depth > 0:
                c = content[i]
                nxt = content[i + 1] if i + 1 < len(content) else ""

                if state == "line_comment":
                    if c == "\n":
                        state = None
                elif state == "block_comment":
                    if c == "*" and nxt == "/":
                        state = None
                        i += 1
                elif state == "sq":
                    if c == "\\":
                        i += 1
                    elif c == "'":
                        state = None
                elif state == "dq":
                    if c == "\\":
                        i += 1
                    elif c == '"':
                        state = None
                elif state == "tpl":
                    if c == "\\":
                        i += 1
                    elif c == "`":
                        state = None
                    elif c == "$" and nxt == "{":
                        state = None
                        tpl_depth += 1
                        depth += 1
                        i += 1
                else:
                    if c == "/" and nxt == "/":
                        state = "line_comment"
                        i += 1
                    elif c == "/" and nxt == "*":
                        state = "block_comment"
                        i += 1
                    elif c == "'":
                        state = "sq"
                    elif c == '"':
                        state = "dq"
                    elif c == "`":
                        state = "tpl"
                    elif c == "{":
                        depth += 1
                    elif c == "}":
                        depth -= 1
                        if tpl_depth > 0 and depth >= 1:
                            tpl_depth -= 1
                            state = "tpl"
                i += 1

            body = content[m.end():i - 1]
            result.append(f"{js_prefix}\n{body}\n}});")
            pos = i

        self.content = "".join(result)

    def _inline_external_assets(self):
        content = self.content

        def inline_script(match):
            src = match.group(1)
            path = os.path.join(self.source_dir, src)
            try:
                with open(path, "r", encoding="utf-8") as f:
                    js = f.read()
            except FileNotFoundError:
                logger.warning("Script not found: %s", path)
                return match.group(0)
            return f"<script>\n{js}\n</script>"

        content = re.sub(
            r'<script\s+src=["\']([^"\']+)["\']\s*(?:type=["\']text/javascript["\'])?\s*></script>',
            inline_script,
            content,
        )

        def inline_style(match):
            href = match.group(1)
            path = os.path.join(self.source_dir, href)
            try:
                with open(path, "r", encoding="utf-8") as f:
                    css = f.read()
            except FileNotFoundError:
                logger.warning("Stylesheet not found: %s", path)
                return match.group(0)
            return f"<style>\n{css}\n</style>"

        content = re.sub(
            r'<link\s+rel=["\']stylesheet["\']\s+href=["\']([^"\']+)["\']\s*/?>',
            inline_style,
            content,
        )

        self.content = content


def parse_app(source_dir, fxapi_path, output_path):
    return AppParser(source_dir, fxapi_path, output_path).parse()


# ============================================================
# Manifest + packaging
# ============================================================

def _copy_tree(src, dst):
    os.makedirs(dst, exist_ok=True)
    for name in os.listdir(src):
        if name in IGNORE_NAMES:
            continue
        s = os.path.join(src, name)
        d = os.path.join(dst, name)
        if os.path.isdir(s):
            shutil.copytree(s, d, dirs_exist_ok=True, ignore=shutil.ignore_patterns(*IGNORE_NAMES))
        else:
            shutil.copy2(s, d)


def build_manifest(debug=False):
    """
    Matches the real Hotoe manifest.json format:
        { "id": "com.application.my", "debug": true, ... }
    """
    app_id = "".join(str(randint(0, 99)) for _ in range(10))
    return {
        "id": "com.application" + app_id,
        "debug": debug,
        "compiled_at": datetime.now(timezone.utc).isoformat(),
    }


def stage_project_into_engine(project_dir, engine_dir, fxapi_path, debug=False):
    """
    `run`: copies every file from `project_dir` (cwd the CLI was called
    from) into <engine_dir>/execute, parses index.html there, and writes
    manifest.json at <engine_dir>/manifest.json — matching:
        dir/manifest.json
        dir/execute/hotoe-execute.html
        dir/execute/<application assets>
        dir/<engine files>
    """
    execute_dir = os.path.join(engine_dir, "execute")
    if os.path.isdir(execute_dir):
        shutil.rmtree(execute_dir)
    _copy_tree(project_dir, execute_dir)

    output_path = os.path.join(execute_dir, "hotoe-execute.html")
    parse_app(source_dir=execute_dir, fxapi_path=fxapi_path, output_path=output_path)

    manifest_path = os.path.join(engine_dir, "manifest.json")
    with open(manifest_path, "w", encoding="utf-8") as f:
        json.dump(build_manifest(debug=debug), f, indent=2)

    return execute_dir


def compile_project(project_dir, fxapi_path, output_zip="Hotoe.zip", debug=False):
    """
    `compile`: no platform/dependency checks. Parses the project into a
    temporary /execute folder, writes manifest.json, zips both into
    Hotoe.zip in the project directory.
    """
    build_dir = os.path.join(project_dir, ".hotoe-build")
    execute_dir = os.path.join(build_dir, "execute")
    if os.path.isdir(build_dir):
        shutil.rmtree(build_dir)
    _copy_tree(project_dir, execute_dir)

    output_path = os.path.join(execute_dir, "hotoe-execute.html")
    parse_app(source_dir=execute_dir, fxapi_path=fxapi_path, output_path=output_path)

    manifest_path = os.path.join(build_dir, "manifest.json")
    with open(manifest_path, "w", encoding="utf-8") as f:
        json.dump(build_manifest(debug=debug), f, indent=2)

    zip_path = os.path.join(project_dir, output_zip)
    if os.path.exists(zip_path):
        os.remove(zip_path)

    with zipfile.ZipFile(zip_path, "w", zipfile.ZIP_DEFLATED) as zf:
        for root, _, files in os.walk(build_dir):
            for file in files:
                full_path = os.path.join(root, file)
                arcname = os.path.relpath(full_path, build_dir)
                zf.write(full_path, arcname)

    shutil.rmtree(build_dir)
    logger.info("Wrote %s", zip_path)
    return zip_path


# ============================================================
# Commands
# ============================================================

def _setup_logging(debug):
    logging.basicConfig(
        level=logging.DEBUG if debug else logging.INFO,
        format="[hotoe] %(levelname)s: %(message)s",
    )


def cmd_run(args):
    _setup_logging(args.debug)
    project_dir = os.getcwd()

    plat = detect_platform()
    logger.info("Detected platform: %s", plat)

    if plat != "linux-wayland":
        logger.error(
            "Only Wayland is supported right now (detected: %s). "
            "Other platforms aren't implemented yet.",
            plat,
        )
        sys.exit(1)

    engine_dir = download_engine()

    if check_wayland_dependencies():
        logger.info("All Wayland dependencies OK, installing pip requirements")
        subprocess.run(
            [sys.executable, "-m", "pip", "install", *WAYLAND_PIP_REQUIREMENTS],
            check=True,
        )
    else:
        logger.error("One or more Wayland dependencies are missing (see log above).")
        sys.exit(1)

    fxapi_path = os.path.join(engine_dir, "fxAPI.js")
    stage_project_into_engine(
        project_dir=project_dir,
        engine_dir=engine_dir,
        fxapi_path=fxapi_path,
        debug=args.debug,
    )

    logger.info("Launching engine: %s", ENGINE_RUN_COMMAND)
    subprocess.run(ENGINE_RUN_COMMAND, cwd=engine_dir, check=True)


def cmd_compile(args):
    _setup_logging(args.debug)
    project_dir = os.getcwd()

    fxapi_path = download_fxapi()
    zip_path = compile_project(
        project_dir=project_dir,
        fxapi_path=fxapi_path,
        output_zip="Hotoe.zip",
        debug=args.debug,
    )
    logger.info("Compiled: %s", zip_path)


def cmd_build(args):
    print("`hotoe build` is not implemented yet.")


def main():
    parser = argparse.ArgumentParser(prog="hotoe")
    sub = parser.add_subparsers(dest="command", required=True)

    run_p = sub.add_parser("run", help="Run the app (Wayland only for now)")
    run_p.add_argument("-debug", "--debug", dest="debug", action="store_true")
    run_p.set_defaults(func=cmd_run)

    compile_p = sub.add_parser("compile", help="Compile the app into Hotoe.zip")
    compile_p.add_argument("-debug", "--debug", dest="debug", action="store_true")
    compile_p.set_defaults(func=cmd_compile)

    build_p = sub.add_parser("build", help="(not implemented yet)")
    build_p.set_defaults(func=cmd_build)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
