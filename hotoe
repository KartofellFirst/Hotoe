#!/usr/bin/env python3
"""
Hotoe CLI — standalone, single-file. No pip dependencies required just to
run this script; only `run` on Wayland pip-installs the engine's own native
bindings (PyGObject / pycairo / pyzmq) once dependency checks pass.

Usage:
    ./hotoe run [-debug]
    ./hotoe compile [-debug]
    ./hotoe build          (not implemented yet)

Install (optional, Linux/macOS):
    chmod +x hotoe
    ./hotoe run

Or just:
    python3 hotoe run
"""

