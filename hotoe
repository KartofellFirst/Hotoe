def _check_ctypes_lib(lib_name):
    from ctypes import CDLL
    try:
        CDLL(lib_name)
        return True, None
    except Exception as e: return False, str(e)

_BINDING_CHECK_SCRIPT = r"""
import json, importlib
results = {}
def check(name, fn):
    try:
        fn()
        results[name] = None
    except Exception as e:
        results[name] = str(e)

check("gi", lambda: importlib.import_module("gi"))
def _gi_stack():
    import gi
    gi.require_version("Gtk", "4.0")
    gi.require_version("Gtk4LayerShell", "1.0")
    gi.require_version("WebKit", "6.0")
    from gi.repository import Gtk, Gio, Gdk, Gtk4LayerShell, WebKit
check("gi_stack", _gi_stack)
check("cairo", lambda: importlib.import_module("cairo"))
check("zmq", lambda: importlib.import_module("zmq"))
print(json.dumps(results))
"""

def check_python_bindings(venv_python):
    proc = subprocess.run(
        [venv_python, "-c", _BINDING_CHECK_SCRIPT],
        capture_output=True, text=True,
    )
    try:
        results = json.loads(proc.stdout.strip().splitlines()[-1])
    except Exception:
        logger.error("[FAIL] could not parse binding check output -> %s", proc.stderr)
        return False

    labels = {
        "gi": "gi (PyGObject)",
        "gi_stack": "gi.repository: Gtk4 / Gtk4LayerShell / WebKit6",
        "cairo": "cairo (pycairo)",
        "zmq": "zmq (pyzmq)",
    }
    all_ok = True
    for key, label in labels.items():
        err = results.get(key)
        if err is None:
            logger.info("[OK]   %s", label)
        else:
            all_ok = False
            logger.error("[FAIL] %s -> %s", label, err)
    return all_ok

def check_native_library():
    ok, error = _check_ctypes_lib("libgtk4-layer-shell.so")
    if ok:
        logger.info("[OK]   libgtk4-layer-shell.so")
    else:
        logger.error("[FAIL] libgtk4-layer-shell.so -> %s", error)
    return ok

