# GitHub Releases URLs
ENGINE_ZIP_URL = "https://github.com/KartofellFirst/Hotoe/releases/download/test/Hotoe-Wayland.zip"
FXAPI_JS_URL = "https://github.com/KartofellFirst/Hotoe/releases/download/test/fxAPI.js"

# Command used to launch the engine, run with cwd = the extracted engine dir.
ENGINE_RUN_COMMAND = ["./Hotoe-Wayland/python main.py"]

# Installed via pip only if every Wayland dependency check passes.
WAYLAND_PIP_REQUIREMENTS = ["PyGObject", "pycairo", "pyzmq"]

CACHE_DIR = os.path.join(os.path.expanduser("~"), ".cache", "hotoe")
ENGINE_DIR = os.path.join(CACHE_DIR, "engine")

IGNORE_NAMES = {".git", "__pycache__", ".venv", "node_modules", "Hotoe.zip", ".hotoe-build"}

