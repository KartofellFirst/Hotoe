def cmd_run(args):
    project_dir = args.wd or os.getcwd()

    if PLATFORM == "linux-wayland":
        download_engine()
        if not check_native_libraries():
            logger.error("Please, make sure you installed every required package")
            sys.exit(1)

        logger.info("Running pip...")
        subprocess.run([sys.executable, "-m", "pip", "install", *WAYLAND_PIP_REQUIREMENTS], check=True)
        logger.info("pip has finished the job >>> next: last final check")

        if not check_python_bindings():
            logger.error("After pip install some libraries has not been installed. (Check logs above)")
            sys.exit(1)
        
        stage_engine_into_project(
            project_dir=project_dir,
            platform=PLATFORM,
            debug=args.debug,
            input_file=args.set_main or "index.html"
        )

        logger.info("Launching engine")
        subprocess.run(ENGINE_RUN_COMMAND[PLATFORM], shell=True, check=True)
        return
    
    logger.error(
        "Only Wayland is supported right now (detected: %s). "
        "Other PLATFORMforms aren't implemented yet.",
        PLATFORM,
    )
    sys.exit(1)
    
def cmd_compile(args):
    project_dir = args.wd or os.getcwd()
    download_engine()
    output = stage_engine_into_project(project_dir=project_dir, platform=PLATFORM)
    shutil.make_archive('app', 'zip', output)
    logger.info("Compilation finished successfully -> %s", str(os.path.join(project_dir, "app.zip")))

