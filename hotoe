# ============================================================
# Wayland dependency checks
# ============================================================

def _check_ctypes_lib(lib_name):
    from ctypes import CDLL
    try:
        CDLL(lib_name)
        return True, None
    except Exception as e: return False, str(e)

def _check_import(module_name):
    try:
        importlib.import_module(module_name)
        return True, None
    except Exception as e: return False, str(e)

def _check_gi_stack():
    try:
        import gi
        gi.require_version("Gtk", "4.0")
        gi.require_version("Gtk4LayerShell", "1.0")
        gi.require_version("WebKit", "6.0")
        from gi.repository import Gtk, Gio, Gdk, Gtk4LayerShell, WebKit  
        return True, None
    except Exception as e: return False, str(e)

def check_native_libraries():
    ok, error = _check_ctypes_lib("libgtk4-layer-shell.so")
    if ok:
        logger.info("[OK]   libgtk4-layer-shell.so")
    else:
        logger.error("[FAIL] libgtk4-layer-shell.so -> %s", error)
    return ok


def check_python_bindings():
    checks = [
        ("gi (PyGObject)", lambda: _check_import("gi")),
        ("gi.repository: Gtk4 / Gtk4LayerShell / WebKit6", _check_gi_stack),
        ("cairo (pycairo)", lambda: _check_import("cairo")),
        ("zmq (pyzmq)", lambda: _check_import("zmq")),
    ]
    all_ok = True
    for label, check_fn in checks:
        ok, error = check_fn()
        if ok:
            logger.info("[OK]   %s", label)
        else:
            all_ok = False
            logger.error("[FAIL] %s -> %s", label, error)
    return all_ok
