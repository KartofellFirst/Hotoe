def cmd_run(args):
    project_dir = args.wd or os.getcwd()

    if PLATFORM == "linux-wayland":
        engine_dir = download_engine()

        if not check_native_library():
            logger.error(
                ""libgtk4-layer-shell not found.\n"
                "The library may exist under a versioned name (.so.0, .so.1, etc.) — "
                "create a symlink to the unversioned .so name and try again."
            )
            sys.exit(1)

        venv_python = ensure_wayland_venv()
        install_wayland_pip_requirements(venv_python)

        if not check_python_bindings(venv_python):
            logger.error(
                "Some bindings are still missing after pip install (see log above). "
                "GI typelibs (Gtk4LayerShell/WebKit6) usually come from your system "
                "package manager, e.g.: pacman -S gtk4-layer-shell webkitgtk-6.0"
            )
            sys.exit(1)

        output_dir = stage_engine_into_project(
            project_dir=project_dir,
            platform=PLATFORM,
            debug=args.debug,
            input_file=args.set_main or "index.html"
        )

        logger.info("Launching engine")
        subprocess.run([venv_python, "main.py"], cwd=output_dir, check=True)
        return

    logger.error(
        "Only Wayland is supported right now (detected: %s). "
        "Other platforms aren't implemented yet.",
        PLATFORM,
    )
    sys.exit(1)
    
def cmd_compile(args):
    project_dir = args.wd or os.getcwd()
    download_engine()
    output = stage_engine_into_project(project_dir=project_dir, platform=PLATFORM)
    path = os.path.join(output, "run.sh")
    with open(path, "w", encoding="utf-8", newline="\n") as f:
        f.write(RUN_SH_TEMPLATE)
    os.chmod(path, 0o755)
    archive_base = os.path.join(project_dir, "app")
    archive_path = shutil.make_archive(archive_base, "zip", output)
    logger.info("Compilation finished successfully -> %s", archive_path)

