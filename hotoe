class AppParser:
    def __init__(self, project_dir, fxapi_path, input_file, debug):
        self.source_dir = project_dir
        self.input_file = os.path.join(project_dir, input_file)
        self.fxapi_path = fxapi_path
        self.output_dir = os.path.join(project_dir, ".hotoe")
        self.debug_mode = debug
        self.content = ""
        self.fxAPI = ""

    def parse(self):
        with open(self.input_file, "r", encoding="utf-8") as f:
            self.content = f.read()
        with open(self.fxapi_path, "r", encoding="utf-8") as f:
            self.fxAPI = f.read()

        self._inline_external_assets()

        if "<script>" not in self.content: self.content = self.content.replace("</body>", "<script></script></body>")
        if "<head>" not in self.content: self.content = self.content.replace("<body>", "<head></head><body>")

        self.content = re.sub(r"<html[^>]*>", "<html>", self.content, flags=re.IGNORECASE)

        self.content = self.content.replace("</head>", "<style>html { background: rgba(0,0,0,0.01); }</style>")

        self.content = self.content.replace("<script>", f"\n<script>\n{self.fxAPI}\n</script>\n<script>")

        self.content = self.content.replace("{% LOCAL_BUS_ADDRESS %}", "ipc://hotoe-bus.ipc")

        self.content = re.sub(rf"<\s*(\w+)([^>]*?)\s+{re.escape('SIR')}([^>]*)>", r'<\1\2 class="hotoe-input-region-regulator-box"\3>', self.content)

        for key, val in SHORTCUTS.items():
            self._smart_method_replace(key, val)

        for key, val in LISTENERS.items():
            self._smart_listener_replace(key, val)

        with open(os.path.join(self.output_dir, "execute", "hotoe-execute.html"), "w", encoding="utf-8") as f:
            f.write(self.content)
        with open(os.path.join(self.output_dir, "manifest.json"), "w", encoding="utf-8") as mf:
            mf.write(self._create_manifest())
        return self.output_dir

    def _create_manifest(self):
        meta_tags = re.findall(r'<meta\s+name=["\']([^"\']+)["\']\s+content=["\']([^"\']+)["\']\s*/?>', self.content)
        rid = "".join(str(randint(0, 99)) for _ in range(10))
        result = { "id": f"com.hotoe.dummy-{rid}", "developer": "sleepyhead_forgot_to_set_meta_tags", "debug": self.debug_mode }

        for name, content in meta_tags:
            if name == 'id': result['id'] = content
            elif name == 'developer': result['developer'] = content
        return json.dumps(result)

    def _smart_method_replace(self, replace, replaced):
        pattern = rf"(?<!\.)\b{re.escape(replace)}\s*\("
        self.content = re.sub(pattern, f"{replaced}(", self.content)

    def _smart_listener_replace(self, key, js_prefix):
        pattern = re.compile(rf"(?<![:\w])\b{re.escape(key)}\s*\{{")
        result = []
        pos = 0
        content = self.content

        while True:
            m = pattern.search(content, pos)
            if not m:
                result.append(content[pos:])
                break
            result.append(content[pos:m.start()])

            depth = 1
            i = m.end()
            state = None  # None | 'sq' | 'dq' | 'tpl' | 'line_comment' | 'block_comment'
            tpl_depth = 0

            while i < len(content) and depth > 0:
                c = content[i]
                nxt = content[i + 1] if i + 1 < len(content) else ""

                if state == "line_comment":
                    if c == "\n":
                        state = None
                elif state == "block_comment":
                    if c == "*" and nxt == "/":
                        state = None
                        i += 1
                elif state == "sq":
                    if c == "\\":
                        i += 1
                    elif c == "'":
                        state = None
                elif state == "dq":
                    if c == "\\":
                        i += 1
                    elif c == '"':
                        state = None
                elif state == "tpl":
                    if c == "\\":
                        i += 1
                    elif c == "`":
                        state = None
                    elif c == "$" and nxt == "{":
                        state = None
                        tpl_depth += 1
                        depth += 1
                        i += 1
                else:
                    if c == "/" and nxt == "/":
                        state = "line_comment"
                        i += 1
                    elif c == "/" and nxt == "*":
                        state = "block_comment"
                        i += 1
                    elif c == "'":
                        state = "sq"
                    elif c == '"':
                        state = "dq"
                    elif c == "`":
                        state = "tpl"
                    elif c == "{":
                        depth += 1
                    elif c == "}":
                        depth -= 1
                        if tpl_depth > 0 and depth >= 1:
                            tpl_depth -= 1
                            state = "tpl"
                i += 1

            body = content[m.end():i - 1]
            result.append(f"{js_prefix}\n{body}\n}});")
            pos = i

        self.content = "".join(result)

    def _inline_external_assets(self):
        content = self.content

        def inline_script(match):
            src = match.group(1)
            path = os.path.join(self.source_dir, src)
            try:
                with open(path, "r", encoding="utf-8") as f:
                    js = f.read()
            except FileNotFoundError:
                logger.warning("Script not found: %s", path)
                return match.group(0)
            return f"<script>\n{js}\n</script>"

        content = re.sub(
            r'<script\s+src=["\']([^"\']+)["\']\s*(?:type=["\']text/javascript["\'])?\s*></script>',
            inline_script,
        content)

        def inline_style(match):
            href = match.group(1)
            path = os.path.join(self.source_dir, href)
            try:
                with open(path, "r", encoding="utf-8") as f:
                    css = f.read()
            except FileNotFoundError:
                logger.warning("Stylesheet not found: %s", path)
                return match.group(0)
            return f"<style>\n{css}\n</style>"

        content = re.sub(
            r'<link\s+rel=["\']stylesheet["\']\s+href=["\']([^"\']+)["\']\s*/?>',
            inline_style,
        content)

        self.content = content

def _copy_tree(src, dst):
    os.makedirs(dst, exist_ok=True)
    for name in os.listdir(src):
        if name in IGNORE_NAMES:
            continue
        s = os.path.join(src, name)
        d = os.path.join(dst, name)
        if os.path.isdir(s):
            shutil.copytree(s, d, dirs_exist_ok=True, ignore=shutil.ignore_patterns(*IGNORE_NAMES))
        else:
            try: shutil.copy2(s, d)
            except: logger.warning("%s were ignored while copying project files", s)

def stage_engine_into_project(project_dir, platform, input_file="index.html", debug=False):
    fxapi_path = os.path.join(CACHE_DIR, platform, "fxAPI.js")
    engine_dir = os.path.join(CACHE_DIR, platform)
    output_dir = os.path.join(project_dir, ".hotoe")
    execute_dir = os.path.join(project_dir, ".hotoe", "execute")
    if os.path.isdir(output_dir): shutil.rmtree(output_dir)

    _copy_tree(project_dir, execute_dir)
    _copy_tree(engine_dir, output_dir)

    AppParser(project_dir, fxapi_path, input_file, debug).parse()
    return output_dir

