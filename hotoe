def main():
    parser = argparse.ArgumentParser(prog="hotoe")
    sub = parser.add_subparsers(dest="command", required=True)

    run_p = sub.add_parser("run", help="build and run the application on the current device")
    run_p.add_argument("-d", "--debug", dest="debug", action="store_true")
    run_p.add_argument("-w", "--wd", dest="wd", help="working directory path")
    run_p.add_argument("-s", "--set_main", dest="set_main", help="set main file name")
    run_p.set_defaults(func=cmd_run)

    compile_p = sub.add_parser("compile", help="compile the app into app.zip with run.sh file")
    compile_p.add_argument("-w", "--wd", dest="wd", help="working directory path")
    compile_p.set_defaults(func=cmd_compile)

    build_p = sub.add_parser("build", help="(not implemented yet)")
    build_p.set_defaults(func=cmd_build)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
