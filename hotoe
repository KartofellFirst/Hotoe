def _venv_dir():
    return os.path.join(CACHE_DIR, PLATFORM + "-venv")

def _venv_python():
    bin_name = "Scripts/python.exe" if PLATFORM == "windows" else "bin/python"
    return os.path.join(_venv_dir(), bin_name)

def ensure_wayland_venv():
    venv_python = _venv_python()
    if os.path.isfile(venv_python):
        return venv_python
    venv_dir = _venv_dir()
    logger.info("Creating venv at %s", venv_dir)
    subprocess.run(
        [sys.executable, "-m", "venv", "--system-site-packages", venv_dir],
        check=True,
    )
    return venv_python

def install_wayland_pip_requirements(venv_python):
    logger.info("Installing pip requirements into venv")
    subprocess.run(
        [venv_python, "-m", "pip", "install", *WAYLAND_PIP_REQUIREMENTS],
        check=True,
    )



